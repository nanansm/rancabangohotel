---
import Base from "../layouts/Base.astro";
import { BOOKING_URL, OTA, IG_URL, TIKTOK_URL } from "../data/content";

// Biolink — semua tautan penting jadi satu. Semua buka tab baru.
const WA_ROOM = "https://api.whatsapp.com/send?phone=628112237711&text=" + encodeURIComponent("Hi min, saya mau booking room di Rancabango Hotel");
const WA_GROUP = "https://api.whatsapp.com/send?phone=6287811032922&text=" + encodeURIComponent("Hi min, saya mau reservasi group & event di Rancabango Hotel");
const WA_WEDDING = "https://api.whatsapp.com/send?phone=6289691681905&text=" + encodeURIComponent("Hello kak, saya mau nanya info wedding di Rancabango Hotel ya!");
const MAPS = "https://maps.app.goo.gl/zQLAfGqRBVMDECFe8";

const contacts = [
  { href: WA_ROOM, fb: "wa", label: "Reservasi Room", sub: "via WhatsApp", icon: "wa" },
  { href: WA_GROUP, fb: "wa", label: "Reservasi Group & Event", sub: "via WhatsApp", icon: "wa" },
  { href: WA_WEDDING, fb: "wa", label: "Info Wedding Venue", sub: "via WhatsApp", icon: "wa" },
  { href: MAPS, fb: null, label: "Lokasi — Google Maps", sub: "Tarogong Kaler, Garut", icon: "pin" },
];
---
<Base
  path="/link/"
  title="Rancabango Hotel & Resort — Semua Link (Booking, WhatsApp, Lokasi)"
  description="Satu halaman untuk booking langsung, WhatsApp reservasi kamar, group & event, wedding, lokasi, dan OTA Rancabango Hotel & Resort Garut.">
  <main class="relative min-h-[100dvh] bg-[#1b3d4a] text-white">

    <!-- ===== Hero photo — bayangkan menginap di sini ===== -->
    <div class="relative h-[62dvh] min-h-[440px] w-full overflow-hidden">
      <img src="/images/aerial-1.webp" alt="Rancabango Hotel & Resort dari udara — cottage kayu, danau, sawah, dan Gunung Guntur"
        class="kenburns absolute inset-0 h-full w-full object-cover object-[center_45%]" fetchpriority="high" width="2200" height="1238" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#1b3d4a]/25 via-[#1b3d4a]/35 to-[#1b3d4a]"></div>
      <div class="absolute inset-x-0 bottom-0 flex flex-col items-center px-6 pb-7 text-center">
        <img src="/logo/logo-full-white.webp" alt="Rancabango Hotel & Resort" class="h-14 w-auto drop-shadow-[0_2px_16px_rgba(0,0,0,0.5)]" width="200" height="120" />
        <p class="mt-4 font-script text-[26px] leading-none text-gold [text-shadow:0_2px_14px_rgba(0,0,0,0.5)]">A place to be present</p>
        <p class="mt-2 text-[13px] text-white/85 [text-shadow:0_1px_10px_rgba(0,0,0,0.5)]">Garut · Nuansa Bali · di kaki Gunung Guntur</p>
      </div>
    </div>

    <!-- ===== Links ===== -->
    <div class="mx-auto w-full max-w-[440px] px-5 pb-14 pt-6">

      <!-- Primary CTA -->
      <a href={BOOKING_URL} target="_blank" rel="noopener" data-fb="reservasi"
         class="group flex items-center gap-4 rounded-2xl bg-white px-5 py-4 text-[#123039] shadow-[0_10px_34px_rgba(0,0,0,0.35)] ring-1 ring-white/70 transition hover:-translate-y-0.5 hover:shadow-[0_14px_40px_rgba(0,0,0,0.4)]">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-gold/25 text-gold-deep">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.7 1.4 6.8L12 17.8 5.9 20.5l1.4-6.8L2.2 9l6.9-.7z"/></svg>
        </span>
        <span class="flex-1">
          <span class="block font-display text-[15px] font-bold leading-tight">Booking Hemat di Official Website</span>
          <span class="mt-0.5 block text-[13px] text-[#3a5560]">Lebih hemat 25% gunakan kode RCB2026</span>
        </span>
        <svg class="h-4 w-4 shrink-0 text-[#3a5560] transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </a>

      <!-- Website resmi — lihat semua fasilitas -->
      <a href="/" target="_blank" rel="noopener"
         class="group mt-3 flex items-center gap-4 rounded-2xl border border-white/25 bg-white/[0.12] px-5 py-3.5 backdrop-blur transition hover:-translate-y-0.5 hover:border-white/35 hover:bg-white/[0.18]">
        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/10 text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 6 4 9-.1 3-1.5 6.4-4 9-2.5-2.6-3.9-6-4-9 .1-3 1.5-6.4 4-9Z"/></svg>
        </span>
        <span class="flex-1">
          <span class="block text-[15px] font-semibold leading-tight text-white">Lihat semua kamar & fasilitas</span>
          <span class="mt-0.5 block text-[13px] text-white/55">Website resmi Rancabango</span>
        </span>
        <svg class="h-4 w-4 shrink-0 text-white/40 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </a>

      <!-- Contacts -->
      <div class="mt-3 space-y-3">
        {contacts.map((b) => (
          <a href={b.href} target="_blank" rel="noopener" data-fb={b.fb}
             class="group flex items-center gap-4 rounded-2xl border border-white/15 bg-white/[0.08] px-5 py-3.5 backdrop-blur transition hover:-translate-y-0.5 hover:border-white/25 hover:bg-white/[0.14]">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/10 text-white">
              {b.icon === "wa" && (<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.1.3.7 1.1 1.4 1.8.9.8 1.7 1.1 2 1.2.2.1.4.1.6-.1l.7-.8c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.3Z"/></svg>)}
              {b.icon === "pin" && (<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.3-7-11a7 7 0 1 1 14 0c0 4.7-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>)}
            </span>
            <span class="flex-1">
              <span class="block text-[15px] font-semibold leading-tight text-white">{b.label}</span>
              <span class="mt-0.5 block text-[13px] text-white/55">{b.sub}</span>
            </span>
            <svg class="h-4 w-4 shrink-0 text-white/40 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
          </a>
        ))}
      </div>

      <!-- OTA -->
      <div class="mt-8">
        <p class="text-center text-[11px] uppercase tracking-[0.2em] text-white/40">Atau pesan lewat</p>
        <div class="mt-4 grid grid-cols-2 gap-3">
          {OTA.map((o) => (
            <a href={o.url} target="_blank" rel="noopener" data-fb="ota" data-ota={o.name}
               class="rounded-xl border border-white/12 bg-white/[0.05] px-4 py-3 text-center text-sm font-medium text-white/85 transition hover:bg-white/[0.12]">
              {o.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Social — satu kolom -->
      <div class="mt-8 space-y-3">
        <a href={IG_URL} target="_blank" rel="noopener"
           class="group flex items-center justify-center gap-2.5 rounded-xl border border-white/12 bg-white/[0.05] py-3 text-sm text-white/85 transition hover:bg-white/[0.12]">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9a3.5 3.5 0 0 1-.9-1.4c-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 3.2A6.6 6.6 0 1 0 18.6 12 6.6 6.6 0 0 0 12 5.4Zm0 10.9A4.3 4.3 0 1 1 16.3 12 4.3 4.3 0 0 1 12 16.3Zm6.8-11.2a1.5 1.5 0 1 1-1.5-1.5 1.5 1.5 0 0 1 1.5 1.5Z"/></svg>
          @rancabango_hotel
        </a>
        <a href={TIKTOK_URL} target="_blank" rel="noopener"
           class="group flex items-center justify-center gap-2.5 rounded-xl border border-white/12 bg-white/[0.05] py-3 text-sm text-white/85 transition hover:bg-white/[0.12]">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3v11.3a2.4 2.4 0 1 1-2.4-2.4c.2 0 .4 0 .6.1V9a5.4 5.4 0 1 0 4.8 5.4V8.7a7.3 7.3 0 0 0 4.2 1.3V7a4.3 4.3 0 0 1-3.2-1.2Z"/></svg>
          @rancabangohotelresort
        </a>
      </div>

      <p class="mt-10 text-center text-xs text-white/35">© 2026 Rancabango Hotel &amp; Resort · Garut</p>
    </div>
  </main>
</Base>
