---
// Mobile sticky — kept minimal and quiet per the campaign's "soft invitation" tone:
// a conversation (WhatsApp) and a reservation link. No urgency, no shouting.
import { BOOKING_URL, WA_URL } from "../data/content";
import T from "../components/T.astro";
---
<div id="book-bar" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-canvas/95 px-4 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] backdrop-blur transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] lg:hidden">
  <div class="flex items-center gap-3">
    <a href={WA_URL} target="_blank" rel="noopener" data-fb="wa" class="inline-flex flex-1 items-center justify-center gap-2 rounded-full border border-teal/30 py-3 text-sm font-medium text-teal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.1.3.7 1.1 1.4 1.8.9.8 1.7 1.1 2 1.2.2.1.4.1.6-.1l.7-.8c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
      <T id="Sapa kami" en="Say hello" />
    </a>
    <a href={BOOKING_URL} target="_blank" rel="noopener" data-fb="reservasi" class="inline-flex flex-1 items-center justify-center rounded-full bg-teal py-3 text-sm font-semibold text-white">
      <T id="Reservasi" en="Reserve" />
    </a>
  </div>
</div>
<script is:inline>
  (function () {
    const bar = document.getElementById("book-bar");
    if (!bar) return;
    // Muncul setelah user melewati hero — landscape full view dulu.
    const onScroll = () => {
      const show = window.scrollY > window.innerHeight * 0.85;
      bar.classList.toggle("translate-y-full", !show);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
