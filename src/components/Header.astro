---
import { nav, BOOKING_URL } from "../data/content";
import T from "./T.astro";
---
<header id="site-header" class="fixed inset-x-0 top-0 z-40 transition-colors duration-300">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-5 py-2 md:px-10 md:py-2.5">
    <a href="/" class="flex items-center" aria-label="Rancabango Hotel & Resort">
      <img src="/logo/logo-full-white.webp" alt="Rancabango Hotel & Resort" class="h-[42px] w-auto md:h-[50px]" data-logo="white" width="128" height="76" />
      <img src="/logo/logo-stacked.webp" alt="Rancabango Hotel & Resort" class="hidden h-[42px] w-auto md:h-[50px]" data-logo="dark" width="128" height="76" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex">
      {nav.map((n) => (
        <a href={n.href} class="text-sm font-medium text-white/90 transition hover:text-white" data-navlink>
          <T id={n.id} en={n.en} />
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div class="flex overflow-hidden rounded-full border border-white/40 text-xs font-semibold" data-langwrap>
        <button data-lang-btn="id" aria-pressed="true" onclick="window.__setLang('id')" class="px-2.5 py-1 text-white">ID</button>
        <button data-lang-btn="en" aria-pressed="false" onclick="window.__setLang('en')" class="px-2.5 py-1 text-white">EN</button>
      </div>
      <a href={BOOKING_URL} target="_blank" rel="noopener" data-navlink data-fb="reservasi" class="hidden text-sm font-medium text-white/90 underline-offset-4 transition hover:text-white hover:underline sm:inline-block">
        <T id="Reservasi" en="Reserve" />
      </a>
      <button id="menu-btn" aria-label="Menu" aria-expanded="false" class="grid h-10 w-10 place-items-center rounded-full border border-white/70 bg-black/10 text-white backdrop-blur-sm lg:hidden">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="drawer" class="invisible fixed inset-0 z-50 opacity-0 transition-opacity duration-300 lg:hidden">
    <div class="absolute inset-0 bg-pine-deep/60 backdrop-blur-sm" data-drawer-close></div>
    <div id="drawer-panel" class="absolute right-0 top-0 flex h-[100dvh] w-[84%] max-w-sm translate-x-full flex-col bg-canvas p-6 shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
      <div class="flex items-center justify-between">
        <img src="/logo/logo-stacked.webp" alt="Rancabango" class="h-11 w-auto" width="128" height="76" />
        <button aria-label="Tutup" data-drawer-close class="grid h-10 w-10 place-items-center rounded-full border border-line text-ink">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <nav class="mt-8 flex flex-col">
        {nav.map((n) => (
          <a href={n.href} data-drawer-link class="border-b border-line py-3.5 font-display text-2xl text-ink">
            <T id={n.id} en={n.en} />
          </a>
        ))}
      </nav>
      <a href={BOOKING_URL} target="_blank" rel="noopener" data-fb="reservasi" class="mt-auto rounded-full bg-teal px-6 py-3.5 text-center font-semibold text-white">
        <T id="Reservasi" en="Reserve" />
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const header = document.getElementById("site-header");
    const drawer = document.getElementById("drawer");
    const panel = document.getElementById("drawer-panel");
    const btn = document.getElementById("menu-btn");
    function open() {
      drawer.classList.remove("invisible", "opacity-0");
      panel.classList.remove("translate-x-full");
      btn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }
    function close() {
      drawer.classList.add("opacity-0");
      panel.classList.add("translate-x-full");
      btn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      setTimeout(() => drawer.classList.add("invisible"), 300);
    }
    btn.addEventListener("click", open);
    drawer.querySelectorAll("[data-drawer-close]").forEach((e) => e.addEventListener("click", close));
    drawer.querySelectorAll("[data-drawer-link]").forEach((e) => e.addEventListener("click", close));
    const onScroll = () => header.classList.toggle("is-solid", window.scrollY > window.innerHeight * 0.7);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>

<style>
  #site-header.is-solid {
    background: color-mix(in srgb, var(--color-canvas) 90%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
  }
  #site-header.is-solid [data-logo="white"] { display: none; }
  #site-header.is-solid [data-logo="dark"] { display: inline-block; }
  #site-header.is-solid [data-navlink] { color: var(--color-ink); }
  #site-header.is-solid [data-langwrap] { border-color: color-mix(in srgb, var(--color-ink) 30%, transparent); }
  #site-header.is-solid [data-lang-btn] { color: var(--color-ink); }
  #site-header.is-solid #menu-btn { border-color: color-mix(in srgb, var(--color-ink) 28%, transparent); color: var(--color-ink); background: transparent; }
  #site-header:not(.is-solid) [data-logo="dark"] { display: none; }
  [data-lang-btn][aria-pressed="true"] { background: #fff; color: var(--color-teal-deep); }
</style>
