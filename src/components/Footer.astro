---
import { nav, OTA, BOOKING_URL, WA_URL, PHONE, PHONE_TEL, IG_URL, TIKTOK_URL, MAPS_URL } from "../data/content";
import T from "./T.astro";
---
<footer class="bg-pine-deep px-6 pb-28 pt-16 text-cream md:px-10 lg:pb-16">
  <div class="mx-auto max-w-[1400px]">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <img src="/logo/logo-full-white.webp" alt="Rancabango Hotel & Resort" class="h-14 w-auto" width="200" height="70" />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-cream/65">
          <T id="Healing resort nuansa Bali di kaki Gunung Guntur, Garut. A Place To Be Present." en="A Balinese-flavoured healing resort at the foot of Mount Guntur, Garut. A Place To Be Present." />
        </p>
        <div class="mt-5 flex flex-col gap-3">
          <a href={IG_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 text-sm text-cream/80 hover:text-white">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9a3.5 3.5 0 0 1-.9-1.4c-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 3.2A6.6 6.6 0 1 0 18.6 12 6.6 6.6 0 0 0 12 5.4Zm0 10.9A4.3 4.3 0 1 1 16.3 12 4.3 4.3 0 0 1 12 16.3Zm6.8-11.2a1.5 1.5 0 1 1-1.5-1.5 1.5 1.5 0 0 1 1.5 1.5Z"/></svg>
            @rancabango_hotel
          </a>
          <a href={TIKTOK_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 text-sm text-cream/80 hover:text-white">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3v11.3a2.4 2.4 0 1 1-2.4-2.4c.2 0 .4 0 .6.1V9a5.4 5.4 0 1 0 4.8 5.4V8.7a7.3 7.3 0 0 0 4.2 1.3V7a4.3 4.3 0 0 1-3.2-1.2Z"/></svg>
            @rancabangohotelresort
          </a>
        </div>
      </div>
      <div>
        <h3 class="font-display text-lg text-white"><T id="Jelajahi" en="Explore" /></h3>
        <ul class="mt-4 space-y-2.5 text-sm text-cream/75">
          {nav.map((n) => (<li><a href={n.href} class="hover:text-white"><T id={n.id} en={n.en} /></a></li>))}
        </ul>
      </div>
      <div>
        <h3 class="font-display text-lg text-white"><T id="Kontak" en="Contact" /></h3>
        <ul class="mt-4 space-y-2.5 text-sm text-cream/75">
          <li><a href={MAPS_URL} target="_blank" rel="noopener" class="hover:text-white">Rancabango, Garut, Jawa Barat 44151</a></li>
          <li><a href={PHONE_TEL} class="hover:text-white">{PHONE}</a></li>
          <li><a href={WA_URL} target="_blank" rel="noopener" data-fb="wa" class="hover:text-white">WhatsApp: +62 811-2237-711</a></li>
        </ul>
        <p class="mt-5 text-sm leading-relaxed text-cream/70">
          <T id="Booking langsung + kode RCB2026 — hemat sampai 20%. Harga terbaik ada di sini." en="Book direct with code RCB2026 — save up to 20%. Best rate is right here." />
        </p>
        <a href={BOOKING_URL} target="_blank" rel="noopener" data-fb="reservasi" class="mt-2 inline-block text-sm font-semibold text-cream underline underline-offset-4 hover:text-white">
          <T id="Reservasi" en="Reserve" />
        </a>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:gap-5">
      <span class="text-xs uppercase tracking-[0.15em] text-cream/45"><T id="Pesan langsung, atau lewat" en="Book direct, or via" /></span>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-cream/75">
        {OTA.map((o) => (
          <a href={o.url} target="_blank" rel="noopener" data-fb="ota" data-ota={o.name} class="transition hover:text-white">{o.name}</a>
        ))}
      </div>
    </div>
    <div class="mt-8 flex flex-col gap-1 border-t border-white/10 pt-6 text-xs text-cream/45 md:flex-row md:items-center md:justify-between">
      <p>© 2026 Rancabango Hotel &amp; Resort.</p>
      <p><T id="Nuansa Bali di kaki Gunung Guntur, Garut." en="Balinese ambience at the foot of Mount Guntur, Garut." /></p>
    </div>
  </div>
</footer>
